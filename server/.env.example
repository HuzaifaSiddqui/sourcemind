# ─── SourceMind API ────────────────────────────────────────────────
# Copy to server/.env. Every value is optional: with nothing set, SourceMind
# runs fully offline (embedded JSON store, local vector index, extractive answers).

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# DATA_DIR=data

# ─── LLM + embeddings (any OpenAI-compatible API) ─────────────────
# Enables generated answers, LLM document summaries and neural embeddings.
# Changing the embedding model re-embeds every passage automatically on boot.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector database (optional) ───────────────────────────────────
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=sourcemind_chunks

# ─── Application database (optional) ──────────────────────────────
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=sourcemind

# ─── Behaviour ────────────────────────────────────────────────────
# AUTO_SEED=true            # load demo workspace when the store is empty
# DEMO_LOGIN=true           # show one-click demo accounts on the sign-in page
# MAX_UPLOAD_MB=25
# PIPELINE_STAGE_DELAY_MS=0 # slow each ingestion stage down for screen recordings
